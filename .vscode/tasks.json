{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "啟動偶數杯杯",
      "type": "process",
      "command": "node",
      "args": ["scripts/dev-server.mjs"],
      "isBackground": true,
      "options": { "cwd": "${workspaceFolder}" },
      "problemMatcher": {
        "owner": "osucup",
        "pattern": { "regexp": "^(.*):(\\d+): (.*)$", "file": 1, "line": 2, "message": 3 },
        "background": {
          "activeOnStart": true,
          "beginsPattern": "^OSUCUP server starting$",
          "endsPattern": "^Local: http://localhost:"
        }
      },
      "presentation": { "reveal": "always", "panel": "dedicated" },
      "runOptions": { "instanceLimit": 1 }
    }
  ]
}
